# Copia este archivo como .env (docker compose lo lee automaticamente).
# Valores para el entorno local con FLOCI (emulador AWS) y Postgres en contenedores del host.
PROXY_PORT=8080
DB_HOST=host.docker.internal
DB_NAME=lomax_db
AWS_ENDPOINT_URL=http://host.docker.internal:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
